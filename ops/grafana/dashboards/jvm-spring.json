      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (id) (jvm_memory_used_bytes{application=\"stickerstore\", area=\"heap\"})",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
