# Spring profile to activate (use "prod" to run against Postgres)
SPRING_PROFILES_ACTIVE=prod

# Datasource — defaults below match the local Postgres service in compose.yaml
DB_URL=jdbc:postgresql://localhost:5432/stickerstore
DB_USERNAME=stickerstore
DB_PASSWORD=stickerstore

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# JWT signing secret — required, at least 32 bytes; the app won't start while it's empty.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
